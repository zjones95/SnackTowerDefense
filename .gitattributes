# Normalize text files to LF in the repository.
* text=auto

# Unity YAML assets and meta files: keep bytes as authored (no EOL conversion),
# so Unity doesn't see spurious diffs.
*.meta      -text
*.unity     -text
*.prefab    -text
*.asset     -text
*.mat       -text
*.anim      -text
*.controller -text
*.overrideController -text
*.physicMaterial -text
*.physicsMaterial2D -text
*.brush     -text
*.flare     -text

# C# / shader sources
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.hlsl      text
*.compute   text

# Truly binary assets
*.glb       binary
*.gltf      binary
*.fbx       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.psd       binary
*.tga       binary
*.exr       binary
*.hdr       binary
*.ttf       binary
*.otf       binary
*.wav       binary
*.mp3       binary
*.ogg       binary
*.a         binary
*.so        binary
*.dll       binary
*.pdb       binary
*.apk       binary
*.aab       binary
*.unitypackage binary

# Unity WebGL player output (prebuilt player lives on the `webgl` branch)
*.unityweb  binary
*.wasm      binary
*.data      binary
*.mem       binary
